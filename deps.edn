{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.1"}

  ;; Host-neutral addon contract. hive-ansatz implements IAddon directly;
  ;; concrete hosts remain outside this dependency graph.
  io.github.hive-agi/hive-addon {:mvn/version "0.2.0"}

  ;; Malli registry, derivation, generation, and test-synthesis bridge.
  io.github.hive-agi/hive-schemas {:mvn/version "0.1.1"}

  ;; Decl snapshot codec (Fressian container format).
  org.clojure/data.fressian {:mvn/version "1.1.0"}}

 :aliases
 {;; The live-ansatz adapter needs the ansatz kernel on the classpath.
  ;; Core namespaces never require it — host-neutrality is preserved by
  ;; loading hive-ansatz.adapters.ansatz only under this alias.
  :ansatz
  {:extra-deps {io.replikativ/ansatz {:local/root "../clones-ref/ansatz"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.3.1"}
                 org.clojure/test.check {:mvn/version "1.1.1"}}}

  :nrepl
  {:extra-paths ["dev" "test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.3.1"}
                 org.clojure/test.check {:mvn/version "1.1.1"}
                 nrepl/nrepl {:mvn/version "1.3.1"}
                 cider/cider-nrepl {:mvn/version "0.52.1"}}
   :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
