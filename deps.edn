{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}

  ;; Host-neutral addon contract. hive-ansatz implements IAddon directly;
  ;; concrete hosts remain outside this dependency graph.
  io.github.hive-agi/hive-addon {:mvn/version "1.1.10"}

  ;; Malli registry, derivation, generation, and test-synthesis bridge.
  io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}}

 ;; Unpublished deps (io.github.hive-agi/hive-fressian, io.replikativ/ansatz)
 ;; are supplied by the untracked local.deps.edn:
 ;;   clj -Sdeps "$(cat local.deps.edn)" ...
 ;; deps.edn stays :mvn/version-only.

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.5.0"}
                 org.clojure/test.check {:mvn/version "1.1.3"}}}

  :nrepl
  {:extra-paths ["dev" "test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.5.0"}
                 org.clojure/test.check {:mvn/version "1.1.3"}
                 nrepl/nrepl {:mvn/version "1.8.0"}
                 cider/cider-nrepl {:mvn/version "0.52.1"}}
   :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
          slipset/deps-deploy {:mvn/version "0.2.5"}}
   :ns-default build}}}
